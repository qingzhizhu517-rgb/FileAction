# 合成占位值。仅复制到本机受控 .env；不要提交真实密钥。
FILEACTION_ENV=development
FILEACTION_DATABASE_URL=postgresql+psycopg://fileaction_app:replace-runtime-password@postgres:5432/fileaction
FILEACTION_AUTH_DATABASE_URL=postgresql+psycopg://fileaction_auth_login:replace-auth-password@postgres:5432/fileaction
# 仅 Worker 读取受限队列调度角色；不能提供给 API，也不能使用迁移账号替代。
# 仅验证配置（不启动服务）：docker compose --env-file .env.example --profile worker config
FILEACTION_DISPATCHER_DATABASE_URL=postgresql+psycopg://fileaction_dispatch_login:replace-dispatcher-password@postgres:5432/fileaction
FILEACTION_REDIS_URL=redis://:replace-redis-password@redis:6379/0
FILEACTION_APP_SECRET=replace-with-random-32-byte-or-longer-secret
FILEACTION_COOKIE_SECURE=false
FILEACTION_REGISTRATION_ENABLED=false
FILEACTION_ALLOWED_ORIGINS=http://127.0.0.1:8785
FILEACTION_TRUSTED_HOSTS=127.0.0.1,localhost

# COS 仅由后端读取；缺失时就绪检查返回 503。
FILEACTION_COS_REGION=
FILEACTION_COS_BUCKET=
FILEACTION_COS_PREFIX=fileaction/
FILEACTION_COS_SECRET_ID=
FILEACTION_COS_SECRET_KEY=
FILEACTION_COS_SESSION_TOKEN=
FILEACTION_COS_SSE_MODE=
# 默认要求版本控制；无版本桶可显式使用 immutable_key（独立原件键且禁止覆盖）。
FILEACTION_COS_OBJECT_MODE=versioned

# 模型与 Embedding 各自配置、各自授权；不能互相继承。
FILEACTION_MODEL_BASE_URL=
FILEACTION_MODEL_API_KEY=
FILEACTION_MODEL_NAME=
FILEACTION_EMBEDDING_BASE_URL=
FILEACTION_EMBEDDING_API_KEY=
FILEACTION_EMBEDDING_MODEL=
FILEACTION_EMBEDDING_DIMENSIONS=
FILEACTION_EMBEDDING_PROFILE_VERSION=
FILEACTION_EMBEDDING_MAX_BATCH_ITEMS=10
FILEACTION_EMBEDDING_MAX_BATCH_TOKENS=

# Compose 的 PostgreSQL 初始化密码；正式部署使用受控 secret 管理。
FILEACTION_POSTGRES_SUPERUSER_PASSWORD=replace-superuser-password
FILEACTION_REDIS_PASSWORD=replace-redis-password
# 仅显式迁移容器读取；不能提供给 API 或 Worker。
FILEACTION_MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:replace-superuser-password@postgres:5432/fileaction
FILEACTION_RUNTIME_PASSWORD=replace-runtime-password
FILEACTION_AUTH_PASSWORD=replace-auth-password
FILEACTION_DISPATCHER_PASSWORD=replace-dispatcher-password
